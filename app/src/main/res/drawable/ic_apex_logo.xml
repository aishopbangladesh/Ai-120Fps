<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagonal / Shield Outer Cyber Ring -->
    <path
        android:pathData="M54,16 L84,32 L84,72 L54,92 L24,72 L24,32 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="16"
                android:endX="84"
                android:endY="92"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#00FF66" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Shield Glow -->
    <path
        android:pathData="M54,24 L78,37 L78,69 L54,85 L30,69 L30,37 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#1E2D4A">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="85"
                android:type="linear">
                <item android:color="#131F33" android:offset="0.0" />
                <item android:color="#09101D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyber Lightning / Speed Bolt -->
    <path
        android:pathData="M58,32 L40,54 L52,54 L46,74 L68,48 L56,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="32"
                android:endX="68"
                android:endY="74"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#00FF66" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Target Dots -->
    <path
        android:pathData="M54,20 A2,2 0 1,1 54,20.01"
        android:strokeWidth="2"
        android:strokeColor="#00FF66" />
    <path
        android:pathData="M81,70 A2,2 0 1,1 81,70.01"
        android:strokeWidth="2"
        android:strokeColor="#00E5FF" />
    <path
        android:pathData="M27,70 A2,2 0 1,1 27,70.01"
        android:strokeWidth="2"
        android:strokeColor="#00E5FF" />
</vector>
